#!/usr/bin/env bash

source_bin="`dirname $(realpath $0)`/bin"
default_bin="$HOME/bin"
bin_folders="/usr/local/bin $HOME/bin"

echo "Will try to link scripts in $bin_folders"
echo "$HOME/bin will be created if previous paths aren't writable, and it doesn't exist"

target_bin=${default_bin}

for folder in ${bin_folders}
do  

  if [ -d $folder ]
  then
    if [ ! -w $folder ]
    then
      #echo "folder $folder is not writable by current user"
      continue
    fi

    # bin found and writable
    target_bin=$folder
  fi
done

if [ "${folder}" == "${default_bin}" ]
then
  mkdir -p ${default_bin}
fi

echo "installing in $target_bin"
for b in "$source_bin"/*
do
  cmdname=`basename $b`
  if [ ! -f ${target_bin}/$cmdname ]
  then
    echo "linking $b to $target_bin"
    ln -s ${b} ${target_bin}
  else
    echo "link from $b to $target_bin already exists"
  fi
done

# Offer to install Claude rules if ~/.claude is present
claude_md="$HOME/.claude/CLAUDE.md"
rules_src="$(dirname $(realpath $0))/.claude/tf-scripts.md"
rules_dest="$HOME/.claude/rules/tf-scripts.md"
rules_import="@rules/tf-scripts.md"
if [[ -d "$HOME/.claude" ]]; then
  if grep -qF "$rules_import" "$claude_md" 2>/dev/null; then
    echo ""
    echo "Claude rules already installed ($rules_import in $claude_md)"
  else
    echo ""
    echo -e "\e[34m~/.claude detected.\e[0m tf-scripts has Claude rules that help AI assistants"
    echo "format commands correctly and read plan/apply output from files."
    echo ""
    echo "Install now? [y/N]"
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      mkdir -p "$HOME/.claude/rules"
      cp "$rules_src" "$rules_dest"
      echo "" >> "$claude_md"
      echo "$rules_import" >> "$claude_md"
      echo "Installed $rules_dest and added $rules_import to $claude_md"
    else
      echo "Skipped. To install manually:"
      echo "  mkdir -p \"\$HOME/.claude/rules\""
      echo "  cp \"$rules_src\" \"$rules_dest\""
      echo "  echo \"$rules_import\" >> \"$claude_md\""
    fi
  fi
fi
