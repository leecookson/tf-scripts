#!/usr/bin/env bash

# source tfcommon from same bin folder
. "$(dirname $(realpath $0))/tfcommon"

parse_apply_opts "$@"

echo "Current working directory: $(pwd)"
# echo "Files in current directory: $(ls -la)"
echo "Detected folder ${folder}, env ${env}"

usage() {
  echo "Usage: $0 <folder[/env]> [--target <resource>] ... [--reconfigure]"
  echo ""
  echo "  folder[/env]        Path to Terraform config folder, optionally with env (e.g. aws/prod)"
  echo "  --target <resource> Limit plan to specific resource or module. Repeatable."
  echo "  --reconfigure       Pass -reconfigure to terraform init instead of -migrate-state"
  echo ""
  echo "Output: saves ANSI-stripped plan output to work/plan.txt"
  echo ""
  echo "Examples:"
  echo "  $0 aws"
  echo "  $0 azure/staging"
  echo "  $0 aws --target aws_s3_bucket.assets --target aws_iam_role.lambda"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
fi

echo "tf plan $folder"

is_tf_folder "$folder" || exit 1

setupworkfolder_cached $folder || { echo "Failed to setup work folder $folder"; exit 1; }

terraform fmt -check -v

terraform plan -input=false $(target_args) -out plan.tfplan | tee >(sed $'s/\033\[[0-9;]*m//g' > plan.txt)
plan_exit=${PIPESTATUS[0]}

target="${folder}${env:+/$env}"
ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
if [[ $plan_exit -eq 0 ]]; then
  echo -e "\e[34mPlan for ${target} complete SUCCESS at ${ts}\e[0m"
  echo "PLAN RESULT: ${target} SUCCESS at ${ts}" >> plan.txt
else
  echo -e "\e[31mPlan for ${target} FAILED at ${ts}\e[0m"
  echo "PLAN RESULT: ${target} FAILED (exit code ${plan_exit}) at ${ts}" >> plan.txt
fi
exit $plan_exit
