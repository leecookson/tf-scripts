#!/usr/bin/env bash

# source tfcommon from same bin folder
. "$(dirname $(realpath $0))/tfcommon"

# first parameter is folder/env, handled by tfcommon
state_cmd=${2:-show}
resource_address=${3}
resource_target_address=${4} # to support "mv" command

# echo "$folder $state_cmd $resource_address $resource_target_address"

usage() {
  echo "Usage: $0 <folder[/env]> <state_cmd> [<resource_address>] [<target_address>]"
  echo ""
  echo "  folder[/env]       Path to Terraform config folder, optionally with env (e.g. aws/prod)"
  echo "  state_cmd          State sub-command: list | show | rm | mv"
  echo "  resource_address   Resource address — required for show, rm, mv"
  echo "  target_address     Destination address — required for mv only"
  echo ""
  echo "Examples:"
  echo "  $0 aws list"
  echo "  $0 aws show aws_instance.web"
  echo "  $0 azure/prod rm aws_instance.old"
  echo "  $0 gcp mv google_storage_bucket.old google_storage_bucket.new"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" || "$2" == "-h" || "$2" == "--help" ]]; then
  usage
fi

[[ -z "$state_cmd" ]] && usage

[[ "$state_cmd" != "list" ]] && [[ -z "$resource_address" ]] && usage

[[ "$state_cmd" == "mv" ]] && [[ -z "$resource_target_address" ]] && usage

is_tf_folder "$folder" || exit 1

setupworkfolder_cached $folder || { echo "Failed to setup work folder $folder"; exit 1; }

# this is dynamic based on the state_cmd, so we catenate and execute the result
cmd="terraform state $state_cmd $resource_address $resource_target_address"
echo $cmd
$cmd
