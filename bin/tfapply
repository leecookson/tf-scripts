#!/usr/bin/env bash

# source tfcommon from same bin folder
. "$(dirname $(realpath $0))/tfcommon"

parse_apply_opts "$@"

usage() {
  echo "Usage: $0 <folder[/env]> [--target <resource>] ... [--reconfigure]"
  echo ""
  echo "  folder[/env]        Path to Terraform config folder, optionally with env (e.g. aws/prod)"
  echo "  --target <resource> Limit plan/apply to specific resource or module. Repeatable."
  echo "  --reconfigure       Pass -reconfigure to terraform init instead of -migrate-state"
  echo ""
  echo "Output: saves ANSI-stripped plan to work/plan.txt, apply to work/apply.txt"
  echo ""
  echo "Examples:"
  echo "  $0 aws"
  echo "  $0 azure/prod"
  echo "  $0 aws --target aws_s3_bucket.assets --target aws_iam_role.lambda"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
fi

is_tf_folder "$folder" || exit 1

setupworkfolder_cached $folder || { echo "Failed to setup work folder $folder"; exit 1; }

terraform plan -input=false $(target_args) -out plan.tfplan | tee >(sed $'s/\033\[[0-9;]*m//g' > plan.txt)
plan_exit=${PIPESTATUS[0]}

terraform apply -input=false $(target_args) "plan.tfplan" | tee >(sed $'s/\033\[[0-9;]*m//g' > apply.txt)
apply_exit=${PIPESTATUS[0]}

target="${folder}${env:+/$env}"
ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
if [[ $apply_exit -eq 0 ]]; then
  echo -e "\e[34mApply for ${target} complete SUCCESS at ${ts}\e[0m"
  echo "APPLY RESULT: ${target} SUCCESS at ${ts}" >> apply.txt
else
  echo -e "\e[31mApply for ${target} FAILED at ${ts}\e[0m"
  echo "APPLY RESULT: ${target} FAILED (exit code ${apply_exit}) at ${ts}" >> apply.txt
fi
exit $apply_exit
