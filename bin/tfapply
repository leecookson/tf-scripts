#!/usr/bin/env bash

# source tfcommon from same bin folder
. "$(dirname $(realpath $0))/tfcommon"

parse_apply_opts "$@"

is_tf_folder $folder || usage
usage() {
  echo "Usage: $0 [folder|folder/env]"
  echo "Example: $0 aws"
  echo "Example: $0 aws/dev"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
fi

is_tf_folder "$folder" || exit 1

setupworkfolder_cached $folder || { echo "Failed to setup work folder $folder"; exit 1; }

terraform plan -input=false $(target_args) -out plan.tfplan
echo "TARGET_ARGS $target_args"

terraform apply -input=false $(target_args) "plan.tfplan"
apply_exit=$?

target="${folder}${env:+/$env}"
if [[ $apply_exit -eq 0 ]]; then
  echo -e "\e[34mApply for ${target} complete SUCCESS\e[0m"
else
  echo -e "\e[31mApply for ${target} FAILED\e[0m"
fi
exit $apply_exit
